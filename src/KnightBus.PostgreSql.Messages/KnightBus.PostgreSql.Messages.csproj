<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Description>PostgreSQL Messages for KnightBus</Description>
    <Version>2.1.0$(VersionSuffix)</Version>
    <PackageTags>knightbus;postgresql;queues;messaging</PackageTags>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KnightBus.Messages\KnightBus.Messages.csproj" />
  </ItemGroup>
</Project>
