<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Description>Application Insights for KnightBus</Description>
    <Version>14.0.0$(VersionSuffix)</Version>
    <PackageTags>knightbus;applicationinsights;azure;</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference
      Include="Microsoft.ApplicationInsights.DependencyCollector"
      Version="2.23.0"
    />
    <PackageReference
      Include="Microsoft.ApplicationInsights.PerfCounterCollector"
      Version="2.23.0"
    />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\knightbus\src\KnightBus.Core\KnightBus.Core.csproj" />
  </ItemGroup>
</Project>
