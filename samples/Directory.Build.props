<Project>
  <!--
    Directory.Build.props resolution stops at the first file found walking up,
    so chain the repository root one explicitly.
  -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- Samples are not published packages. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
