<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!--
      Shared test helpers, not a published package. This project has no
      Microsoft.NET.Test.Sdk reference, so IsPackable must be set explicitly:
      GeneratePackageOnBuild=false alone still lets `dotnet pack` package it.
    -->
    <IsPackable>false</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="NUnit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\KnightBus.Core.Management\KnightBus.Core.Management.csproj" />
    <ProjectReference Include="..\..\src\KnightBus.Host\KnightBus.Host.csproj" />
  </ItemGroup>
</Project>
