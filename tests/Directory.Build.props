<Project>
  <!--
    Directory.Build.props resolution stops at the first file found walking up,
    so chain the repository root one explicitly.
  -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!--
      Microsoft.NET.Test.Sdk sets this for the suites, but KnightBus.Shared.Tests.Integration
      does not reference it, and GeneratePackageOnBuild=false alone still lets `dotnet pack`
      package a project.
    -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NUnit" />
  </ItemGroup>
</Project>
